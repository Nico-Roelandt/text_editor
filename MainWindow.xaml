<Window x:Class="TextEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TextEditor"
        mc:Ignorable="d"
        Title="Text Editor" Height="600" Width="900" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

<Menu Grid.Row="0">
  <MenuItem Header="File">
    <MenuItem Header="_Save" Click="SaveFile_Click" InputGestureText="Ctrl+S" />
    <MenuItem Header="Save As..." Click="SaveAsFile_Click" />
    <MenuItem Header="_Open..." Click="OpenFile_Click" />
  </MenuItem>
  <MenuItem Header="Edit">
    <MenuItem Command="ApplicationCommands.Copy"/>
    <MenuItem Command="ApplicationCommands.Cut"/>
    <MenuItem Command="ApplicationCommands.Paste"/>
  </MenuItem>
</Menu>


<RichTextBox Grid.Row="1"
         x:Name="Editor"
         AcceptsReturn="True"
         AcceptsTab="True"
         IsInactiveSelectionHighlightEnabled="True"
         SelectionChanged="Editor_SelectionChanged"
         TextChanged="Editor_TextChanged"
         VerticalScrollBarVisibility="Auto"
         HorizontalScrollBarVisibility="Auto"
         FontFamily="Consolas"
         FontSize="15"
         Padding="10" />

<Border Grid.Row="2"
        x:Name="SelectionToolbar"
        Visibility="Collapsed"
        Background="#F3F3F3"
        BorderBrush="#D0D0D0"
        BorderThickness="0,1,0,0"
        Padding="8">
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
    <TextBlock Text="Selection"
               VerticalAlignment="Center"
               Margin="0,0,12,0" />
    <Button Content="B"
            FontWeight="Bold"
            ToolTip="Bold"
            Focusable="False"
            MinWidth="36"
            Margin="2"
            Click="ToggleBold_Click" />
    <Button Content="I"
            FontStyle="Italic"
            ToolTip="Italic"
            Focusable="False"
            MinWidth="36"
            Margin="2"
            Click="ToggleItalic_Click" />
    <Button Content="A−"
            ToolTip="Decrease font size"
            Focusable="False"
            MinWidth="36"
            Margin="2"
            Click="DecreaseFont_Click" />
    <Button Content="A+"
            ToolTip="Increase font size"
            Focusable="False"
            MinWidth="36"
            Margin="2"
            Click="IncreaseFont_Click" />
  </StackPanel>
</Border>


    </Grid>
</Window>
