<Window x:Class="TextEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TextEditor"
        mc:Ignorable="d"
        Title="Text Editor" Height="600" Width="900" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

<Menu Grid.Row="0">
  <MenuItem Header="File">
    <MenuItem Header="_Save" Click="SaveFile_Click" InputGestureText="Ctrl+S" />
    <MenuItem Header="Save As..." Click="SaveAsFile_Click" />
    <MenuItem Header="_Open..." Click="OpenFile_Click" />
  </MenuItem>
  <MenuItem Header="Edit">
    <MenuItem Command="ApplicationCommands.Copy"/>
    <MenuItem Command="ApplicationCommands.Cut"/>
    <MenuItem Command="ApplicationCommands.Paste"/>
  </MenuItem>
  <MenuItem Header="Font">
    <MenuItem Header="Bold" Click="ToggleBold_Click"/>
    <MenuItem Header="Italic" Click="ToggleItalic_Click"/>
    <Separator/>
    <MenuItem Header="Increase Font Size"
              Click="IncreaseFont_Click"/>
    <MenuItem Header="Decrease Font Size"
              Click="DecreaseFont_Click"/>
  </MenuItem>
</Menu>


<RichTextBox Grid.Row="1"
         x:Name="Editor"
         AcceptsReturn="True"
         AcceptsTab="True"
         TextChanged="Editor_TextChanged"
         VerticalScrollBarVisibility="Auto"
         HorizontalScrollBarVisibility="Auto"
         FontFamily="Consolas"
         FontSize="15"
         Padding="10" />


    </Grid>
</Window>
